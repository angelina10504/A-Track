<?xml version="1.0" encoding="utf-8"?>
<!-- Round red SOS button; grey while it is cooling down after a send. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#9E9E9E" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#B71C1C" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#E53935" /></shape>
    </item>
</selector>
