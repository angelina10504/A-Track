<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_purple_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/dashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#373434"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROU - Track Dashboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User: +91 9876543210"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Scrolling content with the SOS button floating over its bottom-right corner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Google Map Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#FAFAFA">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Location Tracking"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:padding="12dp"/>

                    <fragment
                        android:id="@+id/mapFragment"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Current Location Data Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Location Data"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="8dp"/>

                    <!-- Line 1: Latitude, Longitude -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tvLatitude"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lat: --"
                            android:textSize="13sp"
                            android:textColor="@android:color/black"/>

                        <TextView
                            android:id="@+id/tvLongitude"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Long: --"
                            android:textSize="13sp"
                            android:textColor="@android:color/black"/>
                    </LinearLayout>

                    <!-- Line 2: Speed, DateTime -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDateTime"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DtTime: --"
                            android:textSize="13sp"
                            android:textColor="@color/black"/>

                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Spd: --"
                            android:textSize="13sp"
                            android:textColor="@color/black"/>
                    </LinearLayout>

                    <!-- Hidden Angle TextView (keep for compatibility) -->
                    <TextView
                        android:id="@+id/tvAngle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Angle: --"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Camera"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#2C2831"
                android:textColor="@color/white"/>
            <Button
                android:id="@+id/btnFilterLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filter Location Records"
                android:layout_marginBottom="8dp"
                android:textColor="@color/white"
                android:backgroundTint="#6137AD"/>

            <Button
                android:id="@+id/btnFilterSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filter Session Records"
                android:layout_marginBottom="8dp"
                android:textColor="@color/white"
                android:backgroundTint="#6137AD"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="@color/white"
                android:backgroundTint="@android:color/holo_red_dark"/>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:gravity="center"
                android:text="v4.5"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:alpha="0.7" />

        </LinearLayout>
    </ScrollView>

    <!-- Floating SOS button. The scroll view gets extra bottom padding in code, so any
         control underneath can always be scrolled clear of it. -->
    <FrameLayout
        android:id="@+id/sosContainer"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clipChildren="false"
        android:elevation="8dp">

        <ProgressBar
            android:id="@+id/sosProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:minHeight="88dp"
            android:maxHeight="88dp"
            android:indeterminate="false"
            android:max="3000"
            android:progress="0"
            android:progressDrawable="@drawable/sos_ring" />

        <TextView
            android:id="@+id/btnSos"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/sos_button_bg"
            android:clickable="true"
            android:contentDescription="SOS. Hold for 3 seconds to send an emergency alert"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:text="SOS"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    </FrameLayout>

</LinearLayout>